{
  "rewrites": [
    { "source": "/uploads/(.*)", "destination": "https://realchat-api-production.up.railway.app/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "cleanUrls": false
}
